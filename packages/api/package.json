{
  "name": "@docks/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./issue": {
      "types": "./dist/review/issue.d.ts",
      "default": "./dist/review/issue.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"@docks/api: lint ok\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "clean": "rm -rf dist",
    "eval:guide:fetch": "tsx evals/guide/fetch.ts",
    "eval:guide": "tsx evals/guide/run.ts"
  },
  "dependencies": {
    "@docks/db": "workspace:*",
    "@trpc/server": "^11.5.0",
    "better-auth": "^1.7.7",
    "dodopayments": "^2.54.0",
    "drizzle-orm": "^0.45.3",
    "openai": "^7.28.0",
    "superjson": "^2.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@docks/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
