# Public API origin, baked in at build time (the Worker deploy sets it).
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
# PostHog project key (phc_...). Unset = analytics silently disabled.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional ingest override; defaults to the /ingest reverse proxy.
NEXT_PUBLIC_POSTHOG_HOST=
# Release metadata; production CI supplies the commit SHA.
NEXT_PUBLIC_RELEASE_SHA=local
# Generate browser source maps for secure CI upload only. Never publish .map assets.
DOCKS_SOURCE_MAPS=0
