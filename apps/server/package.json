{
  "name": "@docks/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/node.ts",
    "start": "node dist/node.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "lint": "echo \"@docks/server: lint ok\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"@docks/server: no tests yet\"",
    "clean": "rm -rf dist",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@docks/api": "workspace:*",
    "@docks/db": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@trpc/server": "^11.5.0",
    "better-auth": "^1.7.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "superjson": "^2.2.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@docks/typescript-config": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.148.0"
  }
}
