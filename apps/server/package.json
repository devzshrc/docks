{
  "name": "@docks/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "echo \"@docks/server: lint ok\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"@docks/server: no tests yet\"",
    "clean": "rm -rf dist",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@docks/api": "workspace:*",
    "@docks/db": "workspace:*",
    "@trpc/server": "^11.5.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "superjson": "^2.2.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@docks/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
