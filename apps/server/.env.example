PORT=4000
CLIENT_URL=http://localhost:3000
# Comma-separated extra origins, e.g. https://app.example.com
# CORS_ORIGINS=

# Postgres via `docker compose up -d db` (host port 5433).
DATABASE_URL=postgresql://docks:docks@localhost:5433/docks

# Better Auth — public base URL of this server.
BETTER_AUTH_URL=http://localhost:4000
# Min 32 chars. Generate: openssl rand -base64 32. Never commit the real value.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# GitHub App (plan.md §9.2)
GITHUB_APP_ID=
# App URL slug, from https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# PEM contents; "\n" escapes are fine on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# App OAuth credentials, for acting as the user (reviews, merges).
# App "Callback URL": <BETTER_AUTH_URL>/integrations/github/oauth/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Encrypts stored GitHub user tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Email via Resend (verification, password reset, invites). Without a key,
# emails are printed to this server's log in development.
RESEND_API_KEY=
EMAIL_FROM="Docks <noreply@yourdomain.com>"
# "Continue with GitHub" uses GITHUB_APP_CLIENT_ID/SECRET above. On the GitHub App:
#  - add <BETTER_AUTH_URL>/api/auth/callback/github as a second Callback URL;
#  - under Account permissions set "Email addresses" to Read-only (so private emails can sign in);
#  - keep "Request user authorization (OAuth) during installation" off.
# Signing in with GitHub also connects the account (tokens stored encrypted with
# TOKEN_ENCRYPTION_KEY above), so people can review and merge as themselves right away.
# OpenAI key for AI review guides (plan.md §6.3)
OPENAI_API_KEY=
# Optional: model for review guides (default gpt-6-astra)
# OPENAI_GUIDE_MODEL=
# Slack (plan.md §5.4). Slack app needs the "incoming-webhook" scope.
# Redirect URL: <BETTER_AUTH_URL>/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Dodo Payments (plan.md §11)
DODO_PAYMENTS_API_KEY=
# Webhook signing key; endpoint: <BETTER_AUTH_URL>/webhooks/dodo-payments
DODO_PAYMENTS_WEBHOOK_KEY=
# Per-seat monthly subscription product for the Team plan (pdt_...)
DODO_PAYMENTS_PRODUCT_ID=
# test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Comma-separated emails allowed to see /admin/metrics (product analytics).
ADMIN_EMAILS=
# Team plan price per seat (USD/month), used for revenue in admin analytics.
TEAM_SEAT_PRICE_USD=12
